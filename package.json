{
  "name": "landev-track-app",
  "private": true,
  "version": "1.0.9",
  "description": "Secure Electron desktop app for employee session tracking with offline sync.",
  "author": "LANDev Engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamiAbdullatif20/landev-track-app.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build:dev": "dotenv -e .env.dev -- npm run build",
    "build:staging": "dotenv -e .env.staging -- npm run build",
    "build:prod": "dotenv -e .env.prod -- npm run build",
    "dist:win": "npm run build:prod",
    "build": "npm run typecheck && vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:dir": "npm run typecheck && vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "reset:tracking": "node scripts/reset-local-tracking.mjs",
    "reset:tracking:today": "node scripts/reset-local-tracking.mjs --today",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package": "npm run build",
    "release:win": "dotenv -e .env.prod -- npm run typecheck && dotenv -e .env.prod -- vite build && dotenv -e .env.prod -- cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish always",
    "icons:refresh": "powershell -ExecutionPolicy Bypass -File scripts/refresh-windows-taskbar-icon.ps1",
    "postinstall": "node scripts/embed-win-icon.cjs --dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^8.0.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.4"
  }
}
