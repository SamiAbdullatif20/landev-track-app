// Electron Builder configuration for Windows production packaging.
// Code signing placeholders:
// - Set CSC_LINK and CSC_KEY_PASSWORD env vars in CI for real signing.
// - Optional: add WIN_CSC_LINK / WIN_CSC_KEY_PASSWORD for Windows-specific certs.
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.landev.track",
  "asar": true,
  "productName": "LANDEV Tracker",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "extraMetadata": {
    "main": "dist-electron/main.js"
  },
  "files": [
    "dist",
    "dist-electron",
    "build/icons/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**"
  ],
  "extraResources": [
    {
      "from": ".env.prod",
      "to": ".env.prod"
    },
    {
      "from": "build/sounds",
      "to": "sounds"
    }
  ],
  "npmRebuild": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "unicode": true,
    "installerLanguages": ["en_US"]
  },
  // GitHub Releases (recommended): set owner/repo, then publish with GH_TOKEN.
  // See RELEASE_UPDATES.md for setup and costs.
  "publish": [
    {
      "provider": "github",
      "owner": "YOUR_GITHUB_ORG",
      "repo": "landev-track-app",
      "releaseType": "release"
    }
  ]
}
